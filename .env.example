# Server
HOST=0.0.0.0
PORT=8000

# Model (12GB VRAM → 1.7B CustomVoice). For tighter VRAM use 0.6B:
# MODEL_ID=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
MODEL_ID=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
# MODEL_PATH=./models/Qwen3-TTS-12Hz-1.7B-CustomVoice

DEVICE=cuda:0
DTYPE=bfloat16
# Leave empty unless flash-attn is installed and GPU supports it
ATTN_IMPLEMENTATION=

# Optional shared secret for LAN clients (Bearer / X-API-Key)
API_KEY=

MAX_CONCURRENT=1
